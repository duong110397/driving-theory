# Copy to .env and fill in values. NEVER commit .env.

# Django
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO

# Auth
# Session lifetime in seconds (7 days)
SESSION_COOKIE_AGE=604800
# Max login attempts per IP
LOGIN_THROTTLE_RATE=5/min
# Max exams a user can start
EXAM_CREATE_THROTTLE_RATE=30/hour

# PostgreSQL (used by both the db and backend services)
POSTGRES_DB=driving_theory
POSTGRES_USER=driving_theory
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
